class PuzzleNode:
    def __init__(self, state, parent=None, move=None, g=0, h=0):
        self.state = state
        self.parent = parent
        self.move = move
        self.g = g
        self.h = h
        self.f = g + h
        
    def __lt__(self, other):
        return self.f < other.f

def heuristic(state, goal_state):
    return sum(1 for i in range(9) if state[i] != 0 and state[i] != goal_state[i])

def get_neighbors(state):
    zero_idx = state.index(0)
    row, col = divmod(zero_idx, 3)
    neighbors = []
    
    directions = [
        (-1, 0, 'UP'),
        (1, 0, 'DOWN'),
        (0, -1, 'LEFT'),
        (0, 1, 'RIGHT')
    ]
    
    for dr, dc, move_name in directions:
        new_row, new_col = row + dr, col + dc
        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_zero_idx = new_row * 3 + new_col
            state_list = list(state)
            state_list[zero_idx], state_list[new_zero_idx] = state_list[new_zero_idx], state_list[zero_idx]
            neighbors.append((tuple(state_list), move_name))
            
    return neighbors

def a_star_search(initial_state, goal_state):
    counter = 0
    h_val = heuristic(initial_state, goal_state)
    start_node = PuzzleNode(initial_state, g=0, h=h_val)
    pq = [(start_node.f, counter, start_node)]
    visited = set()
    
    while pq:
        _, _, current_node = heapq.heappop(pq)
        
        if current_node.state == goal_state:
            path = []
            curr = current_node
            while curr is not None:
                path.append(curr)
                curr = curr.parent
            return path[::-1]
        
        if current_node.state not in visited:
            visited.add(current_node.state)
            
            for next_state, move in get_neighbors(current_node.state):
                if next_state not in visited:
                    g_cost = current_node.g + 1
                    h_cost = heuristic(next_state, goal_state)
                    next_node = PuzzleNode(next_state, parent=current_node, move=move, g=g_cost, h=h_cost)
                    counter += 1
                    heapq.heappush(pq, (next_node.f, counter, next_node))
                    
    return None

def print_board(state):
    for i in range(0, 9, 3):
        row_vals = ['B' if x == 0 else str(x) for x in state[i:i+3]]
        print(f"  {' '.join(row_vals)}")

