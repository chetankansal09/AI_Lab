class PuzzleNode:
    def __init__(self, state, parent=None, move=None, depth=0):
        self.state = state
        self.parent = parent
        self.move = move
        self.depth = depth

def get_neighbors(state):
    zero_idx = state.index(0)
    row, col = divmod(zero_idx, 3)
    neighbors = []
    
    directions = [
        (-1, 0, 'UP'),
        (1, 0, 'DOWN'),
        (0, -1, 'LEFT'),
        (0, 1, 'RIGHT')
    ]
    
    for dr, dc, move_name in directions:
        new_row, new_col = row + dr, col + dc
        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_zero_idx = new_row * 3 + new_col
            state_list = list(state)
            state_list[zero_idx], state_list[new_zero_idx] = state_list[new_zero_idx], state_list[zero_idx]
            neighbors.append((tuple(state_list), move_name))
            
    return neighbors

def dls_limited(initial_state, goal_state, limit):
    stack = [(PuzzleNode(initial_state), 0, {initial_state})]
    nodes_explored = 0
    cutoff_occurred = False
    
    while stack:
        current_node, depth, path_set = stack.pop()
        nodes_explored += 1
        
        if current_node.state == goal_state:
            path = []
            curr = current_node
            while curr is not None:
                path.append(curr)
                curr = curr.parent
            return path[::-1], nodes_explored, False
        
        if depth < limit:
            neighbors = get_neighbors(current_node.state)
            for next_state, move in reversed(neighbors):
                if next_state not in path_set:
                    new_path_set = path_set.copy()
                    new_path_set.add(next_state)
                    next_node = PuzzleNode(next_state, parent=current_node, move=move, depth=depth+1)
                    stack.append((next_node, depth + 1, new_path_set))
        else:
            cutoff_occurred = True
            
    return None, nodes_explored, cutoff_occurred

def iterative_deepening_search(initial_state, goal_state):
    depth = 0
    total_nodes_explored = 0
    
    while True:
        result, nodes_in_dls, cutoff = dls_limited(initial_state, goal_state, depth)
        total_nodes_explored += nodes_in_dls
        
        if result is not None:
            return result, total_nodes_explored
            
        if not cutoff:
            return None, total_nodes_explored
            
        depth += 1

def print_board(state):
    for i in range(0, 9, 3):
        row_vals = ['B' if x == 0 else str(x) for x in state[i:i+3]]
        print(f"  {' '.join(row_vals)}")

